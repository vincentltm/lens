; Turing Machine: Looping shift-register melody generator that slowly mutates.
;   knob-main = mutation rate     audio-out-1/2 = melody
(patch
  (def clock1 (clock :bpm 120))
  (def turing1loop (tape '(C3 Eb3 G3 Bb3 C4 Bb3 G3 Eb3)))
  (<- turing1loop (if (chance 2048 :trig clock1) (step turing1loop :len 8 :trig clock1) (snap (add C3 (spread (random :trig clock1) 25)) :scale minor)) :len 8 :trig clock1)
  (def turing1out (step turing1loop :len 8 :trig clock1))
  (def sine1 (sine :note turing1out))
  (def vca1 sine1)

  (<- (audio-out :1) vca1)
  (<- (audio-out :2) vca1)
)

; flare_layout: {"rows":[[{"id":"wsIn","type":"ws-in","left":0,"params":{}},{"id":"clock1","type":"clock","left":120,"params":{"bpm":1638}},{"id":"turing1","type":"turing","left":240,"params":{"prob":2048,"len":4095}},{"id":"sine1","type":"sine","left":420,"params":{"pitch":1935,"cents":2048,"depth":0}}],[{"id":"wsOut","type":"ws-out","left":0,"params":{}},{"id":"vca1","type":"vca","left":120,"params":{"amp":4095}}]],"cables":[{"fromId":"clock1","fromPort":"out","toId":"turing1","toPort":"trig","color":"#ff5e57"},{"fromId":"turing1","fromPort":"out","toId":"sine1","toPort":"note","color":"#00ff66"},{"fromId":"sine1","fromPort":"out","toId":"vca1","toPort":"in","color":"#00ffff"},{"fromId":"vca1","fromPort":"out","toId":"wsOut","toPort":"audio-out-1","color":"#ff5e57"},{"fromId":"vca1","fromPort":"out","toId":"wsOut","toPort":"audio-out-2","color":"#ff5e57"}],"nextId":100}
