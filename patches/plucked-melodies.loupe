; Plucked Melodies: Two Karplus-Strong plucked strings (melody + bass) through a filter and reverb.
;   knob-y = string damp / decay length     audio-out-1/2 = stereo plucked ensemble
(patch
  (def clock1 (clock :bpm 80))
  (def clock1mult2 (follow clock1 :mult 2))
  (def score1score (score '(c4 e4 g4 c5 b4 g4 e4 c4)))
  (def score1note (step :tape (score1score :notes) :trig clock1mult2))
  (def multidiv103div4 (every :n 4 :trig clock1mult2))
  (def pluck1 (pluck :trig clock1mult2 :pitch score1note :damp (add 658.09375 (knob :y) :sat)))
  (def scoreplayer100score (score '(c4 e4 g4 b4)))
  (def scoreplayer100note (step :tape (scoreplayer100score :notes) :trig multidiv103div4))
  (def scoreplayer100gate (onsets :tape (scoreplayer100score :rhythm) :trig multidiv103div4))
  (def pluck102 (pluck :trig scoreplayer100gate :pitch (add scoreplayer100note -12) :damp (add 162.5625 (knob :y) :sat)))
  (def mix101 (clip (add (vca pluck102 2724.0625) (vca pluck1 2866.34375))))
  (def lpf2106 (lpf2 :in mix101 :cut (add 908.5625 (vca (spread scoreplayer100note 132071) 1515.8125) :sat) :res 651.15625))
  (def reverb1 (reverb :in lpf2106 :decay 3875.53125 :mix 3431.25))
  (def reverb1outL reverb1)
  (def reverb1outR (sel reverb1))

  (<- (audio-out :1) reverb1outL)
  (<- (audio-out :2) reverb1outR)
)

