,"toPort":"audio-out-2","color":"#ff4d4d"},{"fromId":"reverb1","fromPort":"outL","toId":"wsOut","toPort":"audio-out-1","color":"#ff4d4d"},{"fromId":"mix101","fromPort":"out","toId":"lpf2106","toPort":"in","color":"#ff4d4d"},{"fromId":"scoreplayer100","fromPort":"note","toId":"lpf2106","toPort":"cut","color":"#4cd137"},{"fromId":"wsIn","fromPort":"knob-y","toId":"pluck102","toPort":"damp","color":"#00d2ff"},{"fromId":"lpf2106","fromPort":"out","toId":"reverb1","toPort":"in","color":"#ff4d4d"}],"nextId":109}
