; Drum Machine: 4-channel step-sequenced drum kit (kick / snare / hat).
;   knob-main = Tempo modulation     knob-x = kick decay     knob-y = hat decay
(patch
  (def clock1 (clock :bpm 120 :fm (vca (knob :main) 3862.125)))
  (def clock1mult2 (follow clock1 :mult 2))
  (def drumseq1kickPat (beat '(x . . . x . . .)))
  (def drumseq1kick (onsets drumseq1kickPat clock1mult2))
  (def drumseq1snarePat (beat '(. . x . . . x .)))
  (def drumseq1snare (onsets drumseq1snarePat clock1mult2))
  (def drumseq1hatPat (beat '(x x x x x x x x)))
  (def drumseq1hat (onsets drumseq1hatPat clock1mult2))
  (def drumseq1percPat (beat '(. . . . . . . .)))
  (def drumseq1perc (onsets drumseq1percPat clock1mult2))
  (def kick1 (kick :trig drumseq1kick :note 36 :decay (add 2048 (knob :x) :sat) :drive 1000))
  (def snare1 (snare :trig drumseq1snare :note 45 :decay 1500 :snappy 2048))
  (def hat1 (hat :trig drumseq1hat :note 80 :decay (add 800 (knob :y) :sat)))
  (def mix1 (clip (add (add (vca kick1 3500) (vca snare1 3000)) (vca hat1 2500))))
  (def vca1 mix1)

  (<- (audio-out :1) vca1)
  (<- (audio-out :2) vca1)
)

